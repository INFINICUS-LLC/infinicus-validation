# BUILD-24 — this file is the human-readable mirror of
# packages/configuration/src/secrets.ts's SECRET_INVENTORY, the single
# source of truth for every environment variable server-side code
# actually reads. Keep the two in sync: an entry here with no matching
# SECRET_INVENTORY row (or vice versa) is a real drift bug, not a style
# nit — this file previously listed SUPABASE_*/JWT_SECRET/SENTRY_DSN
# variables that no code in this repository has ever read (a stale
# leftover predating this monorepo's actual configuration schema);
# they have been removed rather than perpetuated.

# ── Database (secret — rotationPolicyDays: 90, owner: platform-database) ──
# Required for the application process to start.
DATABASE_URL=postgresql://app_role:changeme@localhost:5432/infinicus

# Deploy/migration/grant scripts only — never read by the running
# application process. Requires elevated (non-RLS-restricted) privileges.
ADMIN_DATABASE_URL=postgresql://admin_role:changeme@localhost:5432/infinicus

# ── Database (non-secret) ──────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# ── HTTP (non-secret) ───────────────────────────────────────────────
PORT=3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ALLOWED_ORIGINS=https://infini-cus.com,https://www.infini-cus.com

# ── Email (RESEND_API_KEY secret; unset means verification emails are
# logged, not sent — never blocks registration) ─────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=INFINICUS <noreply@infini-cus.com>
EMAIL_VERIFICATION_URL_BASE=https://infini-cus.com/verify-email

# ── AI Decisions (ANTHROPIC_API_KEY secret; unset means recommendations
# fall back to a deterministic threshold-based generator — never blocks) ──
ANTHROPIC_API_KEY=

# ── Identity exchange (J-3; both non-secret/public values, REQUIRED by the Hetzner/OCI compose files) ──
# SUPABASE_URL: base URL of the Supabase project used by the public site (https). SUPABASE_ANON_KEY: that project's public
# anon/publishable key. Leave empty here; fill in the real values only in the deployed .env. Unset = the exchange route answers 503.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── OFF-1 offline selling (non-secret; OWNER inputs, no defaults) ──
# Offline selling is NOT ENABLED unless OFFLINE_SALES_FUTURE_TOLERANCE_SECONDS is set (the route POST /v1/businesses/:businessId/offline-sales answers 503).
# Do not set it until the owner has approved the per-currency monetary caps (D3) and the drift limits below (DECISION-RECORD-POS-9-OFFLINE-SELLING.md).
# OFFLINE_SALES_FUTURE_TOLERANCE_SECONDS=   (whole seconds, 0-3600: how far a device clock may run ahead of the server)
# OFFLINE_SALES_DRIFT_LIMITS=               (JSON, for example {"KWD":500}: tolerated price drift per currency in minor units; unset or a missing currency = 0, every difference goes to review)

# ── Observability (non-secret) ─────────────────────────────────────
LOG_LEVEL=info

# ── Platform (non-secret) ──────────────────────────────────────────
NODE_ENV=development

# P0-6b event worker (separate process; see infrastructure/deployment/event-worker/README.md). All required to start it; no defaults.
# INFINICUS_EVENT_WORKER_ID=
# INFINICUS_EVENT_WORKER_ACTOR_USER_ID=
# INFINICUS_EVENT_WORKER_DISCOVERY_DATABASE_URL=   (secret; see SECRET_INVENTORY)
# INFINICUS_EVENT_WORKER_INTAKE_STATUS_MAX_AGE_MS=
# INFINICUS_EVENT_WORKER_EXECUTION_STATUS_MAX_AGE_MS=   (required; status/authority answer age judged immediately before a mutation)
# INFINICUS_EXECUTION_KILL_SWITCH=   (optional; can only remove capability; empty = not engaged, any other value = engaged)
# INFINICUS_EVENT_WORKER_CLAIM_TIMEOUT_MS=
# INFINICUS_EVENT_WORKER_BATCH_SIZE=
# INFINICUS_EVENT_WORKER_MAX_SCOPES_PER_CYCLE=
# INFINICUS_EVENT_WORKER_POLL_INTERVAL_MS=
