+import { describe, expect, it } from 'vitest';
+import { LockoutStateUnavailableError } from '@infinicus/authentication';
+import { statusCodeFor } from '../src/errors.js';
+
+describe('AUTH-LOCKOUT-1 HTTP contract', () => {
+  it('maps the controlled lockout-state dependency failure to HTTP 503 without sensitive details', () => {
+    const error = new LockoutStateUnavailableError();
+    expect(statusCodeFor(error.name)).toBe(503);
+    expect(error.message).toBe('Password login is temporarily unavailable. Please try again later.');
+    expect(error.message).not.toMatch(/password=|postgresql:\/\/|database_url/i);
+  });
+});
diff --git a/infinicus-platform/infrastructure/database/migrations/0220_normalize_access_event_tenant_context.sql b/infinicus-platform/infrastructure/database/migrations/0220_normalize_access_event_tenant_context.sql
new file mode 100644
index 00000000..c469f970
--- /dev/null
+++ b/infinicus-platform/infrastructure/database/migrations/0220_normalize_access_event_tenant_context.sql
@@ -0,0 +1,16 @@
+-- AUTH-LOCKOUT-1.DB-02: a transaction-local app.tenant_id can reset to the
+-- empty string on a reused PostgreSQL connection. Treat that value as absent
+-- for this policy's UUID comparison; tenant-scoped rows remain invisible.
+-- The tenantless access-event branch and all existing table privileges remain.
+BEGIN;
+
+ALTER POLICY access_events_isolation ON audit.access_events
+  USING (
+    tenant_id IS NULL
+    OR tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid
+  );
+
+INSERT INTO _migrations (filename) VALUES ('0220_normalize_access_event_tenant_context.sql')
+  ON CONFLICT (filename) DO NOTHING;
+
+COMMIT;
