{
  "name": "@infinicus/event-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Event dispatch worker runtime (P0-6b): outbox dispatch, ledger, subscriptions/inbox, retry and dead-letter, plus the composition of the ABA->BO authorized-action pipeline. Runs as a SEPARATE process (infrastructure/deployment/event-worker); never inside the API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "pg": "^8.12.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@infinicus/database": "workspace:*",
    "@infinicus/event-contracts": "workspace:*",
    "@infinicus/handoff-contracts": "workspace:*",
    "@infinicus/business-operations-runtime": "workspace:*",
    "@infinicus/outcome-monitoring-runtime": "workspace:*",
    "@infinicus/workflow": "workspace:*"
  },
  "bin": {
    "infinicus-event-worker": "./dist/main.js"
  }
}
