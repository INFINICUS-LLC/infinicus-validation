{
  "name": "@infinicus/outcome-monitoring-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Outcome Monitoring runtime (P0-6d): verifies Business Operations execution evidence delivered by operations.action.executed@1 and records its own verification. It never writes Business Operations truth and never claims an outcome it has not measured.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@infinicus/database": "workspace:*",
    "@infinicus/event-contracts": "workspace:*",
    "@infinicus/handoff-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "pg": "^8.12.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  }
}
