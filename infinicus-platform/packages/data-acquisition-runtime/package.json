{
  "name": "@infinicus/data-acquisition-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Data Acquisition runtime — manual JSON intake orchestration, deterministic validation, quality scoring, provenance hashing, and publication preparation (BUILD-31)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@infinicus/shared-types": "workspace:*",
    "@infinicus/database": "workspace:*",
    "pg": "^8.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  }
}
