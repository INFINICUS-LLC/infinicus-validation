# TLS termination for the API. Caddy fetches and renews a real Let's
# Encrypt certificate automatically (no manual certbot steps) as long as
# api.infini-cus.com's DNS A record points at this VM's public IP and
# ports 80/443 are reachable (Hetzner Cloud Firewall + this VM's ufw —
# see cloud-init.yaml and runbook.md).
#
# Replace api.infini-cus.com below if using a different subdomain.

api.infini-cus.com {
	reverse_proxy api:3000

	encode gzip

	# Access log. The webhook intake route carries its bearer token in the URL
	# path (/v1/webhooks/data-acquisition/<token>), so the raw request URI must
	# never reach the logs: the filter below rewrites the token segment to
	# REDACTED before the entry is written. Everything else is logged as
	# before. Validated with `caddy adapt` and a live request (see
	# docs/webhook-token-lifecycle.md, "Log redaction").
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp /v1/webhooks/data-acquisition/[^/?#\s]+ /v1/webhooks/data-acquisition/REDACTED
			}
		}
	}
}
