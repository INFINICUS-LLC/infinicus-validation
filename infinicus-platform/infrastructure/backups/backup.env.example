# /etc/infinicus/backup.env - TEMPLATE for the off-VM backup. Install root-owned, mode 0600:  install -m 0600 -o root -g root backup.env.example /etc/infinicus/backup.env
# Contains NO secrets by design: the S3 client keeps its credentials in its own root/deploy-only config (e.g. ~/.config/rclone/rclone.conf, mode 0600).
# Systemd runs the job as the `deploy` user, so that user must be able to read this file (use group `deploy` and mode 0640) and the S3 client config.

# Public key the backups are encrypted to. Import ONLY the public key on the VM:  gpg --import infinicus-backup-public.asc
# The matching private key is held offline by the owner (password manager / hardware token) and is needed only for restores.
BACKUP_GPG_RECIPIENT=REPLACE_WITH_KEY_FINGERPRINT

# Where objects go. Example with rclone and an S3-compatible bucket configured as remote "offsite" (credential: put-only, NO delete permission):
BACKUP_SINK_CMD='rclone rcat offsite:infinicus-backups/%KEY%'
BACKUP_FETCH_CMD='rclone cat offsite:infinicus-backups/%KEY%'

BACKUP_PREFIX=infinicus-production

# Aws sink alternative (recommended with an upload-only IAM user; the AWS credential lives in ~deploy/.aws/credentials, mode 0600 - never in this file):
# BACKUP_SINK_CMD='aws s3 cp - s3://REPLACE_BUCKET/%KEY% --profile infinicus-backup-writer --region REPLACE_REGION --only-show-errors'
# BACKUP_FETCH_CMD='aws s3 cp s3://REPLACE_BUCKET/%KEY% - --profile infinicus-backup-writer'   # the upload-only credential cannot read; used from the verification machine
# Major version that pg_dump, pg_restore and the server must all report (default 16):
# BACKUP_EXPECT_PG_MAJOR=16
# A dedicated gpg home holding ONLY the public key (--check fails if any secret key exists in the keyring used):
# BACKUP_GNUPGHOME=/etc/infinicus/gnupg
# BACKUP_LABEL=daily            (use e.g. pre-migration-0171 for a one-off backup before a migration)
# BACKUP_STATE_DIR=/var/lib/infinicus-backup
# BACKUP_TMP_DIR=/var/tmp/infinicus-backup
