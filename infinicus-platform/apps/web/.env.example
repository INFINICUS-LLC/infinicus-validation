# apps/web browser configuration (NA-04). All three values are PUBLIC by design and are compiled into the browser bundle at build time.
# Never put a Supabase service_role / secret key here: the app refuses one. Leave unset to get a "not configured" screen (there is no default).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origin of the INFINICUS API, e.g. https://api.<your-domain> (https required; http only for localhost). The API's CORS_ALLOWED_ORIGINS must list this web app's origin.
NEXT_PUBLIC_API_BASE_URL=
